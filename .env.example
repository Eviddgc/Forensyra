# FORENSYRA — environment variables
#
# Copy this file to `.env.local` and fill in the values.
#   cp .env.example .env.local        (macOS / Linux)
#   Copy-Item .env.example .env.local (Windows PowerShell)
#
# Everything here is optional: the site runs fine without any of it, it just
# can't actually deliver application/mentor emails or newsletter sign-ups until
# the EmailJS values below are set. If email isn't configured the forms fail
# honestly (they never claim a message was sent).

# ---------------------------------------------------------------------------
# Canonical site URL
# ---------------------------------------------------------------------------
# Overrides the committed value in content/settings/site.json. Set this in
# Vercel so previews and production always emit the right canonical URLs,
# sitemap and Open Graph tags. On Vercel it is auto-detected, so you only need
# it for a custom domain.
# NEXT_PUBLIC_SITE_URL=https://forensyra.com

# ---------------------------------------------------------------------------
# EmailJS — team application  (/api/apply)
# ---------------------------------------------------------------------------
# Create a free account at https://www.emailjs.com, add an email service and a
# template, then copy the IDs here.
#
# Template must accept these variables:
#   {{name}}, {{email}}, {{role}}, {{message}}, plus any extra answers.
# Notification recipient ("To"): forensyra@outlook.in
# Reply-To:                      {{email}}
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=

# Optional: separate auto-reply template sent to the applicant.
EMAILJS_AUTOREPLY_TEMPLATE_ID=

# Newsletter sign-ups in the footer (/api/newsletter). Template should accept
# {{email}} (and optionally {{source}}).
EMAILJS_NEWSLETTER_TEMPLATE_ID=

# Optional: only needed when "Allow non-browser applications" / private-key
# access is enabled on the EmailJS account.
EMAILJS_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# EmailJS — mentor / advisor application  (/api/mentor)
# ---------------------------------------------------------------------------
# Falls back to EMAILJS_TEMPLATE_ID when left blank.
EMAILJS_MENTOR_TEMPLATE_ID=
EMAILJS_MENTOR_AUTOREPLY_TEMPLATE_ID=
